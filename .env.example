# Digital Bridges NYC — environment configuration
#
# The app invokes AI agents through a provider-neutral CLI adapter. Codex is
# the default provider and must be installed and authenticated on the server:
#   $ codex --version
#   $ codex login status
#
# Claude is optional; select it in the UI or configure it as the default:
#   $ claude --version
#   $ claude -p "hi"        # should return a reply (auth working)
#
# There is NO API key stored by this app; each CLI manages its own authentication.

# Access password for the whole app (backend-verified). There is deliberately
# no source-code default. Generate a long random value for every deployment.
DBRIDGES_PASSWORD=replace-with-a-long-random-password

# Set to 1 ONLY when serving over HTTPS (marks the auth cookie Secure).
# Leave unset/0 for plain-HTTP remote access, or the login cookie won't be sent.
DBRIDGES_SECURE_COOKIE=0

# Force deterministic mock mode for ALL runs (no CLI calls, no cost).
# Useful for CI, demos, and local development. Individual runs can also opt
# into mock mode from the UI regardless of this value.
#   1 = always mock, 0 = use real CLI unless a run opts into mock
DBRIDGES_MOCK_AGENTS=0

# Default provider for new runs: codex or claude.
DBRIDGES_DEFAULT_PROVIDER=codex

# Provider-specific model defaults. Codex uses GPT-5.5 with medium reasoning
# unless a run selects another supported setting in the UI.
DBRIDGES_CODEX_DEFAULT_MODEL=gpt-5.5
DBRIDGES_CODEX_REASONING_EFFORT=medium
DBRIDGES_CLAUDE_DEFAULT_MODEL=claude-haiku-4-5-20251001

# Every real generated turn is reviewed by an LLM before it can become visible.
# Validation uses the same provider, model, and reasoning effort selected for
# the project/run (including Spark). Only the enable/disable switch is global.
DBRIDGES_SEMANTIC_VALIDATOR=1

# Per-agent-call timeout in milliseconds.
DBRIDGES_CALL_TIMEOUT_MS=120000

# Max concurrent agent CLI subprocesses across both providers (process pool size).
DBRIDGES_MAX_CONCURRENCY=4

# Default per-run budget cap in USD. It is enforced only when the selected
# provider reports USD cost. Claude reports cost; Codex CLI currently does not,
# so Codex runs are marked unpriced and do not pause at this threshold.
DBRIDGES_DEFAULT_BUDGET_USD=2.00

# Legacy compatibility: DBRIDGES_DEFAULT_MODEL and DBRIDGES_MOCK_CLAUDE are
# still recognized, but new deployments should use the variables above.
